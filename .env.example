# API Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT=180
MEMORY_API_URL=http://localhost:3000
CHATBOT_API_URL=http://localhost:3000
AGENT_API_URL=http://localhost:3000

# Debugging
DEBUG=false
VERIFY_SSL=true

# LLM Configuration
TEMPERATURE=0.1
CONFIDENCE_THRESHOLD=0.5

# Pipeline Mode: "combined" (recommended for 8B+) or "sequential" (legacy, for 1B)
PIPELINE_MODE=combined

# Memory Mode — controls which memory pipeline(s) run after each conversation:
#   off                — skip everything; no memories written (useful for eval baseline)
#   distiller          — LLM distillation only (default, existing behaviour)
#   neuralese          — raw segment embedding only; no LLM distillation call
#   neuralese-distiller — both paths run in sequence (distilled + neuralese stored)
MEMORY_MODE=distiller

# Prompts are NOT configurable at runtime.
# Prompt text lives in prompts/*.md and is loaded by prompts.py. The PROMPT_* and
# SYSTEM_PREAMBLE env overrides were removed on purpose: with one set, the reported
# promptset_hash no longer described what actually ran, which silently invalidates eval
# baselines. Change a prompt by editing its .md file and bumping prompts/promptset.json.
